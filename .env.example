# ==============================================================================
# TallyAI Environment Configuration Template
# Copy this file to .env for local development, or add these in Render Environment Variables
# ==============================================================================

# Server Port (Render sets this automatically to 10000)
PORT=10000
NODE_ENV=production

# Supabase Cloud Database Configuration
# Obtain these from: Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# SMS Telecom Carrier Delivery (Optional - for real SMS OTP on phones)
# Obtain from: https://www.fast2sms.com/ -> Dev API
FAST2SMS_API_KEY=your_fast2sms_api_key_here
